POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=brokenomore

# Database connection URL (SQLAlchemy compatible)
# Fallback to SQLite if PostgreSQL is not available
DATABASE_URL=sqlite:///./brokenomore.db

# App Settings
APP_ENV=development
SECRET_KEY=brokenomore-super-secret-key-change-in-production-2026
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Forecast settings
DEFAULT_FORECAST_DAYS=90
SAFE_BUFFER_AMOUNT=5000.0
